{
  "name": "diseyn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase:emulators": "npx firebase-tools@13.35.1 emulators:start",
    "firebase:deploy:rules": "npx firebase-tools@13.35.1 deploy --only firestore:rules,storage",
    "firebase:deploy:indexes": "npx firebase-tools@13.35.1 deploy --only firestore:indexes",
    "firebase:deploy": "npx firebase-tools@13.35.1 deploy --only firestore,storage"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/kit": "^2.5.18",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.16.14",
    "daisyui": "^5.0.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "firebase-admin": "^13.8.0"
  }
}
