{
  "name": "diseyn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase:emulators": "npx firebase-tools@13.35.1 emulators:start",
    "firebase:deploy:rules": "npx firebase-tools@13.35.1 deploy --only firestore:rules,storage",
    "firebase:deploy:indexes": "npx firebase-tools@13.35.1 deploy --only firestore:indexes",
    "firebase:deploy": "npx firebase-tools@13.35.1 deploy --only firestore,storage"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/kit": "^2.5.18",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@types/node": "^20.16.14",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "daisyui": "^4.12.24",
    "firebase": "^11.0.2",
    "tailwindcss": "^3.4.14"
  }
}
