rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() &&
        role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    match /designCategories/{categoryId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    match /designSubcategories/{subcategoryId} {
      allow read: if true;
      allow write: if hasRole('admin') || hasRole('designer');
    }

    match /designItems/{designId} {
      // Legacy design docs may not have a `status` field. Treat those as public
      // read-only records to match client-side normalization.
      allow read: if isSignedIn() ||
        !('status' in resource.data) ||
        resource.data.status == 'published';
      allow create: if hasRole('designer');
      allow update, delete: if hasRole('admin') ||
        (hasRole('designer') && request.auth.uid == resource.data.designerId);
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow create, update: if hasRole('admin') ||
        (hasRole('manufacturer') &&
          request.auth.uid == manufacturerId &&
          request.resource.data.id == manufacturerId);
      allow delete: if hasRole('admin');
    }

    match /orders/{orderId} {
      allow create: if hasRole('customer') && request.auth.uid == request.resource.data.customerId;
      allow read: if hasRole('admin') ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.selectedManufacturerId;
      allow update: if hasRole('admin') ||
        (hasRole('manufacturer') && request.auth.uid == resource.data.selectedManufacturerId) ||
        (hasRole('customer') && request.auth.uid == resource.data.customerId);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || hasRole('admin'));
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if hasRole('admin') || request.auth.uid == uid;
    }

    match /manufacturerDesignDecisions/{decisionId} {
      allow read: if isSignedIn();
      allow create: if hasRole('manufacturer') &&
        request.auth.uid == request.resource.data.manufacturerId &&
        request.resource.data.verdict in ['accepted', 'declined'] &&
        request.resource.data.designId is string;
      allow update: if hasRole('manufacturer') &&
        request.auth.uid == resource.data.manufacturerId &&
        request.auth.uid == request.resource.data.manufacturerId &&
        request.resource.data.manufacturerId == resource.data.manufacturerId &&
        request.resource.data.designId == resource.data.designId &&
        request.resource.data.verdict in ['accepted', 'declined'];
    }
  }
}
