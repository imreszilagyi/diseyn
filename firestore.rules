rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() &&
        role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    match /designCategories/{categoryId} {
      allow read: if true;
      allow write: if hasRole('admin') || hasRole('designer');
    }

    match /designItems/{designId} {
      allow read: if resource.data.status == 'published' || isSignedIn();
      allow create: if hasRole('designer');
      allow update, delete: if hasRole('admin') ||
        (hasRole('designer') && request.auth.uid == resource.data.designerId);
    }

    match /manufacturers/{manufacturerId} {
      allow read: if true;
      allow write: if hasRole('admin') || (hasRole('manufacturer') && request.auth.uid == manufacturerId);
    }

    match /orders/{orderId} {
      allow create: if hasRole('customer') && request.auth.uid == request.resource.data.customerId;
      allow read: if hasRole('admin') ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.selectedManufacturerId;
      allow update: if hasRole('admin') ||
        (hasRole('manufacturer') && request.auth.uid == resource.data.selectedManufacturerId) ||
        (hasRole('customer') && request.auth.uid == resource.data.customerId);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || hasRole('admin'));
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if hasRole('admin') || request.auth.uid == uid;
    }
  }
}
